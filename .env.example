# Cấu hình mẫu phpMyAdmin / MySQL cho Quán Cà Xòi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=caxoi_cafe
# Tự tạo bằng lệnh: openssl rand -hex 32
JWT_SECRET=
WEBHOOK_SECRET_KEY=
# Cấu hình cổng thanh toán & Webhook payOS (lấy tại https://my.payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payos
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Đặt TRUST_PROXY=true CHỈ KHI triển khai sau Reverse Proxy tin cậy (Nginx / Cloudflare)
TRUST_PROXY=false
# Tài khoản quản trị viên (SUPER_ADMIN) khởi tạo tự động (mật khẩu tối thiểu 8 ký tự)
ADMIN_USERNAME=quynhnhu
ADMIN_PASSWORD=

# Cấu hình gửi mail tự động thông báo đơn hàng (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cà Xòi Coffee & Tea ☕"

